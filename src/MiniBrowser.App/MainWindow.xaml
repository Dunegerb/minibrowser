<Window x:Class="MiniBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBrowser — Zero Browser Architecture"
        Width="1380"
        Height="880"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Background="#EEF1F5"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#17202A"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="Chrome" Color="#EEF1F5"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Line" Color="#D7DCE5"/>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E6ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D6DBE4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="2,2,2,0"/>
            <Setter Property="MaxWidth" Value="240"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#E2E6ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource Chrome}" Padding="10,7,10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" Content="−" FontSize="18" Click="CloseTab_Click" ToolTip="Fechar aba (Ctrl+W)"/>
                    <Button Style="{StaticResource ChromeButton}" Content="+" FontSize="20" Click="NewTab_Click" ToolTip="Nova aba na mesma cápsula (Ctrl+T)"/>
                </StackPanel>
                <TabControl x:Name="Tabs"
                            Height="39"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="Tabs_SelectionChanged"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ChromeButton}" Content="←" Click="Back_Click" ToolTip="Voltar"/>
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="→" Click="Forward_Click" ToolTip="Avançar"/>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="↻" Click="Reload_Click" ToolTip="Recarregar"/>

                <Border Grid.Column="3" Margin="8,0" Background="#F7F8FA" BorderBrush="#CAD1DC" BorderThickness="1" CornerRadius="11" Height="40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" Foreground="#98A2B3" FontSize="18" VerticalAlignment="Center" Margin="12,0,0,1"/>
                        <TextBox x:Name="Omnibox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Ink}"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0,10,0"
                                 KeyDown="Omnibox_KeyDown"
                                 ToolTip="URL ou pesquisa"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="CapsulePicker"
                          Grid.Column="4"
                          Height="36"
                          MinWidth="116"
                          Margin="4,0,6,0"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="DisplayLabel"
                          SelectionChanged="CapsulePicker_SelectionChanged"
                          ToolTip="Trocar de cápsula cria uma aba isolada"/>

                <Button Grid.Column="5" Style="{StaticResource TextChromeButton}" Content="Histórico" Click="History_Click" ToolTip="Histórico RAM-only desta sessão"/>
                <Button Grid.Column="6" Style="{StaticResource TextChromeButton}" Content="Limpar cache" Click="ClearCache_Click" ToolTip="Limpar cache HTTP da cápsula atual"/>
                <Button Grid.Column="7" Style="{StaticResource TextChromeButton}" Content="Audit" Click="Audit_Click" ToolTip="Auditoria local de rede e policy"/>
                <Button Grid.Column="8" Style="{StaticResource TextChromeButton}" Content="RECAÍ" Click="Relapse_Click" ToolTip="Registrar recaída na Machine"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{StaticResource Muted}" FontSize="11" Text="Machine: OFFLINE/STUB"/>
                <TextBlock x:Name="SessionText" Grid.Column="1" Foreground="#667085" FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <Border Background="White">
            <ContentControl x:Name="BrowserHost"/>
        </Border>
    </DockPanel>
</Window>
